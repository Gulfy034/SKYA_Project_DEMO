; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SKYA_Project_DEMO"
config/features=PackedStringArray("4.3", "Forward Plus")
boot_splash/bg_color=Color(0.0784314, 0.156863, 0.341176, 1)

[dotnet]

project/assembly_name="SKYA_Project_DEMO"

[file_customization]

folder_colors={
"res://assets/": "teal",
"res://doc/": "gray",
"res://scenes/": "orange",
"res://scripts/": "green",
"res://shaders/": "blue"
}
